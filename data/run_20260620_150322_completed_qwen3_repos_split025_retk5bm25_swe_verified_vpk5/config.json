{
  "experiment": {
    "name": "agent-qwen3-ace-qwen3-verified-repos-split-swe-025-retk5-bm25",
    "description": "ACE skillbook learning \u2014 per-repo two-phase experiments (SWE ACE reflector)",
    "max_attempts": 1,
    "force_learn": true,
    "concurrency": 1,
    "random_seed": 42,
    "skillbook": {
      "mode": "per_repo",
      "custom_swe_learn": true,
      "deduplication": {
        "enabled": true,
        "similarity_threshold": 0.85,
        "embedding_provider": "sentence_transformers",
        "local_model_name": "all-MiniLM-L6-v2",
        "within_section_only": true,
        "min_pairs_to_report": 1
      },
      "retrieval": {
        "enabled": true,
        "type": "bm25",
        "top_k": 5,
        "skip_threshold": 10,
        "model": "Qwen/Qwen3-Coder-30B-A3B-Instruct",
        "api_base": "http://localhost:8800/v1",
        "api_key_env": "HOSTED_VLLM_API_KEY",
        "temperature": 0.0,
        "max_tokens": 2048,
        "chunk_size": 200,
        "filter_target": 100
      }
    },
    "split": {
      "manifest": "configs/splits/princeton-nlp__SWE-bench_Verified/val_ratio_0_25.json"
    },
    "baseline_run_dir": "data/run_20260605_111658_completed_qwen3_repos_split025_swe_verified_vpk5",
    "val_pass_k": 5,
    "skillbook_source_dir": "data/run_20260605_111658_completed_qwen3_repos_split025_swe_verified_vpk5"
  },
  "environment": {
    "type": "docker",
    "namespace": "ghcr.io/epoch-research/"
  },
  "agent": {
    "step_limit": 250,
    "cost_limit": 0.0,
    "context": {
      "enabled": false,
      "context_window": 65536,
      "keep_recent_messages": 6,
      "truncate_threshold": 0.85
    }
  },
  "llm": {
    "agent": {
      "provider": "hosted_vllm",
      "model": "Qwen/Qwen3-Coder-30B-A3B-Instruct",
      "api_key_env": "HOSTED_VLLM_API_KEY",
      "temperature": 0.0,
      "max_tokens": 4096,
      "api_base": "http://localhost:8800/v1"
    },
    "ace": {
      "provider": "hosted_vllm",
      "model": "Qwen/Qwen3-Coder-30B-A3B-Instruct",
      "api_key_env": "HOSTED_VLLM_API_KEY",
      "temperature": 0.0,
      "max_tokens": 4096,
      "api_base": "http://localhost:8800/v1"
    }
  },
  "benchmark": {
    "dataset": "princeton-nlp/SWE-bench_Verified",
    "split": "test",
    "max_instances": null,
    "exclude_instances": [
      "sympy__sympy-20590",
      "scikit-learn__scikit-learn-25747",
      "pylint-dev__pylint-7114",
      "pylint-dev__pylint-7228",
      "pylint-dev__pylint-7993",
      "scikit-learn__scikit-learn-25500",
      "scikit-learn__scikit-learn-25570",
      "scikit-learn__scikit-learn-25638",
      "astropy__astropy-8707",
      "astropy__astropy-8872",
      "pylint-dev__pylint-7277",
      "scikit-learn__scikit-learn-25102",
      "scikit-learn__scikit-learn-25232",
      "scikit-learn__scikit-learn-25931",
      "scikit-learn__scikit-learn-25973",
      "scikit-learn__scikit-learn-26194",
      "scikit-learn__scikit-learn-26323",
      "matplotlib__matplotlib-13989",
      "matplotlib__matplotlib-14623"
    ],
    "iterate_repos": [
      "django/django",
      "sympy/sympy",
      "sphinx-doc/sphinx",
      "matplotlib/matplotlib",
      "scikit-learn/scikit-learn",
      "astropy/astropy",
      "pydata/xarray",
      "pytest-dev/pytest"
    ]
  },
  "evaluation": {
    "use_docker": true,
    "timeout": 1800,
    "rm_image": false
  },
  "output": {
    "dir": "data",
    "save_trajectories": true,
    "save_skillbooks": true,
    "save_logs": true,
    "log_level": "INFO"
  },
  "litellm": {
    "suppress_debug_info": true,
    "log_level": "WARNING"
  },
  "observability": {
    "enabled": false,
    "project_name": "agent-swe-ace"
  }
}