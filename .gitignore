!data/val_baseline_aggregated_split025_vpk5_qwen3/
!data/val_baseline_aggregated_split025_vpk5_qwen3/stats/
!data/val_baseline_aggregated_split025_vpk5_qwen3/stats/**
!data/val_baseline_aggregated_split025_vpk5_qwen3/runs_index.json
!data/val_skillbook_aggregated_split025_vpk5_qwen3next_global_default/
!data/val_skillbook_aggregated_split025_vpk5_qwen3next_global_default/stats/
