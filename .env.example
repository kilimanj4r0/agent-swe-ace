# Copy this file to .env and fill in your API keys

# Z.AI API Key (get from https://z.ai/)
ZAI_API_KEY=your-zai-api-key-here

# vLLM API Key (optional, for local vLLM servers)
HOSTED_VLLM_API_KEY=your-vllm-api-key-here

# LLM Observaility
OPIK_API_KEY="local"
OPIK_URL_OVERRIDE="http://localhost:5173/api"

# mini-swe-agent LLM call retry attempts
MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT=200
ACE_LEARN_MAX_RETRIES=200